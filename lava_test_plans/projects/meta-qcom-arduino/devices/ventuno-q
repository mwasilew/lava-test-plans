{% extends "devices/monaco-arduino-monza" %}

{# The image hostname is the Yocto MACHINE name, ventuno-q, and not the board
   name the LAVA device type is named after. #}
{% set BOOT_OS_PROMPT = "root@ventuno-q" %}

{# The base device describes the Debian image layout, which is flashed with
   xbl_s_devprg_ns.melf and splits the spinor content into its own qdl stage.
   meta-qcom-arduino builds the qcs8275-monza eMMC layout instead: it spans
   two eMMC physical partitions (the main user data area and the OTP area
   holding the cdt), so ptool emits a rawprogram/patch pair per physical
   partition and everything is flashed in a single eMMC stage. #}
{% set firehose_program = "prog_firehose_ddr.elf" %}
{% set qdl_stages = [
    {"storage": "emmc",
     "path": "",
     "rawprogram": "rawprogram0.xml rawprogram1.xml",
     "patch": "patch0.xml patch1.xml"}
] %}
