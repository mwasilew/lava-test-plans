{% extends "devices/qcs615-ride" %}

{# the debian image ships five rawprogram/patch pairs, the common device six #}
{% set qdl_stages = [
    {"storage": "ufs", "path": "",
     "rawprogram": "rawprogram0.xml rawprogram1.xml rawprogram2.xml rawprogram3.xml rawprogram4.xml",
     "patch": "patch0.xml patch1.xml patch2.xml patch3.xml patch4.xml"}
] %}
{% set qdl_image_dir = "flash_qcs615-ride_ufs" %}
{% set qdl_rootfs_image = "disk-ufs.img2" %}
{% set qdl_tarball = "flash-ufs.tar.gz" %}

{# exclusions are tracked in                                     #}
{# https://github.com/qualcomm-linux/qcom-deb-images/issues/647 #}
{% import "projects/qcom-deb-images/include/excluded-tests.jinja2" as excluded %}
{# Freq_Scaling, CPU_affinity and smmu read /proc/config.gz, which the #}
{# debian kernel does not provide #}
{% set EXCLUDED_TESTS = excluded.EXCLUDED_TESTS + ['Freq_Scaling', 'CPU_affinity', 'smmu'] %}
{% set EXCLUDED_TESTPLANS = excluded.EXCLUDED_TESTPLANS %}
