{% extends "devices/qcs6490-rb3gen2" %}

{# the ufs flashing stage comes from the common device #}
{% set qdl_image_dir = "flash_qcs6490-rb3gen2-vision-kit_ufs" %}
{% set qdl_rootfs_image = "disk-ufs.img2" %}
{% set qdl_tarball = "flash-ufs.tar.gz" %}

{# ask for the vision kit, an alias of the qcs6490-rb3gen2 device type, #}
{# which also covers the core kit                                       #}
{% block device_type %}qcs6490-rb3gen2-vision-kit{% endblock %}

{# exclusions are tracked in                                     #}
{# https://github.com/qualcomm-linux/qcom-deb-images/issues/647 #}
{% import "projects/qcom-deb-images/include/excluded-tests.jinja2" as excluded %}
{# hotplug passes or fails by chance (qcom-deb-images #692) #}
{# the board exposes no /dev/watchdog on any kernel #}
{# Probe_Failure_Check fails on missing firmware and deferred probes #}
{# Freq_Scaling, CPU_affinity and smmu read /proc/config.gz, which the #}
{# debian kernel does not provide; they pass on the other kernels #}
{% set EXCLUDED_TESTS = excluded.EXCLUDED_TESTS + ['hotplug', 'watchdog', 'Probe_Failure_Check', 'Freq_Scaling', 'CPU_affinity', 'smmu'] %}
{% set EXCLUDED_TESTPLANS = excluded.EXCLUDED_TESTPLANS %}
